# FeedPulse Environment Configuration Template
# Copy this file to .env and adjust variables to match your environment.

# -----------------------------------------------------------------------------
# Environment & Deployment Mode
# -----------------------------------------------------------------------------
# Options: development, production, test
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Backend API & Server Configuration
# -----------------------------------------------------------------------------
# Host interface and port for the FastAPI backend server
HOST=127.0.0.1
PORT=8000

# SQLite database connection URL (default: local feedpulse.db)
DATABASE_URL=sqlite:///./feedpulse.db

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# API key protecting mutating and destructive operations (seed, upload, delete, config)
# In development (ENVIRONMENT=development), if left blank it defaults to 'feedpulse-dev-secret-key'.
# In production (ENVIRONMENT=production), you MUST configure a dedicated high-entropy secret key
# (minimum 16 characters). The application will refuse to start in production if this is missing or weak.
FEEDPULSE_API_KEY=

# Allowed CORS Origins (comma-separated). In production, specify exact client origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Toggle demo data seeding (/api/reviews/seed). Set to 'false' in production to protect data.
ALLOW_DEMO_SEEDING=true

# -----------------------------------------------------------------------------
# CSV Import Hardening Limits
# -----------------------------------------------------------------------------
# Maximum CSV file upload size in bytes (default: 5242880 = 5 MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# Maximum rows processed per CSV upload batch
MAX_UPLOAD_ROWS=5000

# Maximum character length per review text content (oversized reviews are rejected with row error)
MAX_CONTENT_LENGTH=2000

# -----------------------------------------------------------------------------
# Slack Outbound Alerts Integration
# -----------------------------------------------------------------------------
# Slack Incoming Webhook URL for spike alerts (must be https://hooks.slack.com/services/...)
# Leave blank to run in built-in offline Sandbox simulator mode.
SLACK_WEBHOOK_URL=

# Percentage of negative reviews in a batch required to trigger a Slack alert (0-100)
NEGATIVE_THRESHOLD_PCT=30.0

# -----------------------------------------------------------------------------
# Database Backups & Recovery
# -----------------------------------------------------------------------------
# Directory where point-in-time SQLite backups are saved
BACKUP_DIR=./backups

# Number of recent backups to retain before pruning older files (0 to disable pruning)
BACKUP_RETENTION_COUNT=10
