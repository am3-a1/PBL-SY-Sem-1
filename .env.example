# FeedPulse Environment Configuration Template
# Copy this file to .env and adjust variables to match your environment.

# -----------------------------------------------------------------------------
# Environment & Deployment Mode
# -----------------------------------------------------------------------------
# Options: development, production, test
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Backend API & Server Configuration
# -----------------------------------------------------------------------------
# Host interface and port for the FastAPI backend server
HOST=127.0.0.1
PORT=8000

# SQLite or PostgreSQL database connection URL
DATABASE_URL=sqlite:///./feedpulse.db

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Secret API key protecting mutating/destructive operations (seed, upload, delete, config)
# Provide this key in HTTP requests as 'X-API-Key: <KEY>' or 'Authorization: Bearer <KEY>'
FEEDPULSE_API_KEY=feedpulse-dev-secret-key

# Allowed CORS Origins (comma-separated). Never use wildcards with credentials in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Toggle demo data seeding (/api/reviews/seed). Set to 'false' in production to protect data.
ALLOW_DEMO_SEEDING=true

# -----------------------------------------------------------------------------
# CSV Import Hardening Limits
# -----------------------------------------------------------------------------
# Maximum CSV file upload size in bytes (default: 5242880 = 5 MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# Maximum rows processed per CSV upload batch
MAX_UPLOAD_ROWS=5000

# Maximum character length per review text content
MAX_CONTENT_LENGTH=2000

# -----------------------------------------------------------------------------
# Slack Outbound Alerts Integration
# -----------------------------------------------------------------------------
# Slack Incoming Webhook URL for spike alerts (must be https://hooks.slack.com/services/...)
# Leave blank to run in built-in offline Sandbox simulator mode.
SLACK_WEBHOOK_URL=

# Threshold percentage of negative reviews in a batch to trigger an alert (1.0 to 100.0)
NEGATIVE_THRESHOLD_PCT=30.0

# -----------------------------------------------------------------------------
# Database Backups
# -----------------------------------------------------------------------------
# Directory where point-in-time SQLite backups are stored
BACKUP_DIR=./backups

# Number of recent backups to retain before pruning older files
BACKUP_RETENTION_COUNT=10

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Port for the Vite development server
VITE_PORT=5173

# Target URL for backend API proxying in Vite dev server
VITE_API_URL=http://127.0.0.1:8000

# API key for the frontend client to communicate with protected backend endpoints
VITE_API_KEY=feedpulse-dev-secret-key
